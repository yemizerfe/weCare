[TEMPLATE]
# Copy to server/.env before running the API or `docker compose up`.
# Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- API ---
PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/wecare
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SAME_SITE=lax

# --- Docker Compose only (server/docker-compose.yml) ---
# Public origin of the web app, used for CORS. Keep the port in sync with WEB_PORT.
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080
